// ─────────────────────────────────────────────────────────────────────────────
// Obsiddy — framework-tier schema
//
// `prisma.config.ts` points Prisma at the `prisma/schema` folder, so every
// `*.prisma` file in it is part of one schema. `framework-*.prisma` is the
// filename glob Sunrise reserves for a framework tier: Sunrise core never
// creates a file matching it, so this file merges cleanly on upgrade.
//
// THE THREE RULES (see .context/framework/obsiddy/plan.md §1 and D1):
//
//   1. Every table is `@@map("framework_obsiddy_<name>")`. The prefix is what
//      keeps Obsiddy's tables from colliding with a host project's own.
//   2. Every model carries `userId`, and every index leads with it. There is
//      exactly ONE satellite table — `ObsiddySpace` — holding a hand-written FK
//      to `"user"("id") ON DELETE CASCADE. Everything else cascades from that,
//      so GDPR erasure is transitive and no column is ever added to `User`.
//   3. Cross-user reads are structurally impossible in `repo/*` (D5). The
//      schema's job is to make `WHERE userId = $1` the natural query.
//
// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️  (see also the per-model blocks below)
// SIX Postgres objects here are managed via raw SQL in the migration because
// Prisma cannot model them. `npx prisma migrate dev` WILL emit DROP statements
// for all six on every schema-diff run. Always inspect generated migration SQL
// and remove any line touching them before applying — every one of them fails
// **silently, with no error**. (Note: the HNSW index is NOT on today's query path —
// the hybrid search's pre-filter and blended ORDER BY defeat it, verified with
// EXPLAIN — so B3 guards a future restructuring. B4/B6, the GENERATED tsvector
// columns, guard live code: recreated as plain columns they are never populated and
// keyword search silently returns nothing.)
// `lib/framework/obsiddy/db-drift.ts` probes all six; run
// `npm run db:drift-check` after EVERY `migrate dev`. Non-negotiable.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per user — the satellite table everything else hangs off (D1).
///
/// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
/// `framework_obsiddy_space_userId_fkey` (→ `"user"("id") ON DELETE CASCADE`)
/// is hand-written in the migration. Prisma cannot model it because `User`
/// lives in a Sunrise-owned schema file and Obsiddy must not add a relation
/// field there (CLAUDE.md: never add columns to `User`). **That FK is the GDPR
/// cascade** — probe B1 asserts both its existence and its ON DELETE action.
model ObsiddySpace {
  id     String @id @default(cuid())
  userId String @unique

  /// Routing token for email capture: brain+<inboxToken>@<OBSIDDY_INBOX_DOMAIN>.
  inboxToken String @unique

  /// IANA zone. Snooze presets and retention windows resolve HERE, never in
  /// server time — an item that unsnoozes at 2am because the server is UTC is
  /// the kind of small wrongness that makes a tool feel careless (§10).
  timezone String @default("UTC") @db.VarChar(64)

  weeklyCapacityMinutes Int @default(2400)

  /// Time-of-day energy profile, Zod-validated at the boundary.
  energyProfile Json?

  /// Scorer weights (§10). Zod-validated; defaults live in code, not the DB, so
  /// a new factor doesn't need a backfill.
  priorityWeights Json?

  /// Retention windows (§11). Columns from day one so they never need
  /// backfilling against live data.
  retentionPolicy Json?

  /// structured | balanced | exploratory — governs what the morning briefing
  /// SELECTS, not just how it is worded (§6). Never an input to score.ts.
  workStyle String @default("balanced") @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relations for the D1 cascade. Every scoped table hangs off this row,
  // so `DELETE FROM "user"` removes the space and the space removes the brain.
  areas          ObsiddyArea[]
  goals          ObsiddyGoal[]
  projects       ObsiddyProject[]
  tasks          ObsiddyTask[]
  thoughts       ObsiddyThought[]
  links          ObsiddyLink[]
  embeddings     ObsiddyEmbedding[]
  boards         ObsiddyBoard[]
  boardCards     ObsiddyBoardCard[]
  tags           ObsiddyTag[]
  taskTags       ObsiddyTaskTag[]
  checklistItems ObsiddyChecklistItem[]
  entities       ObsiddyEntity[]
  documents      ObsiddyDocument[]
  timeBlocks     ObsiddyTimeBlock[]
  reviews        ObsiddyReview[]
  events         ObsiddyEvent[]

  @@map("framework_obsiddy_space")
}

/// Life domains (Health, Career…). `targetWeeklyMinutes` is what makes this a
/// life organiser rather than a task list — it drives `areaBalance` in the
/// scorer, floating a neglected area above a hot work project (§10).
model ObsiddyArea {
  id     String @id @default(cuid())
  userId String

  name        String
  slug        String
  description String? @db.Text
  colour      String? @db.VarChar(16)
  sortOrder   Int     @default(0)

  targetWeeklyMinutes Int?

  /// private | link. NEVER a filter on the owner's own read path (D5, §13).
  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  /// Bumped in the same UPDATE as every write. Dormant until Release 3 — its
  /// absence would later force a full-table backfill against live data (§15).
  rev Int @default(0)

  /// Null = needs (re)embedding. Archiving nulls it and drops the embedding
  /// rows outright; restoring re-enqueues (§11).
  indexedHash String?

  goals      ObsiddyGoal[]
  projects   ObsiddyProject[]
  timeBlocks ObsiddyTimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, archivedAt])
  @@index([userId, visibility])
  @@map("framework_obsiddy_area")
}

/// Horizons: life → year → quarter → month → week.
model ObsiddyGoal {
  id     String @id @default(cuid())
  userId String

  title       String
  description String? @db.Text

  /// life | year | quarter | month | week. Nearest horizon reached by the
  /// goal-alignment walk scores highest — near horizons are more actionable.
  horizon String @db.VarChar(16)

  parentGoalId String?
  areaId       String?

  targetDate DateTime?

  /// active | achieved | dropped
  status String @default("active") @db.VarChar(16)

  lastActivityAt DateTime?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  parentGoal ObsiddyGoal?  @relation("ObsiddyGoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals ObsiddyGoal[] @relation("ObsiddyGoalTree")
  area       ObsiddyArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, horizon, status])
  @@index([userId, archivedAt])
  @@index([userId, visibility])
  @@index([parentGoalId])
  @@index([areaId])
  @@map("framework_obsiddy_goal")
}

model ObsiddyProject {
  id     String @id @default(cuid())
  userId String

  name        String
  slug        String
  description String? @db.Text

  /// idea | active | paused | done | abandoned
  status String @default("active") @db.VarChar(16)

  areaId String?

  priorityScore   Float @default(0)
  priorityFactors Json?

  lastActivityAt DateTime?
  closedAt       DateTime?

  /// Hidden from the active list; `projectMomentum` decay pauses while set (§10).
  snoozedUntil DateTime?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  area       ObsiddyArea?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks      ObsiddyTask[]
  timeBlocks ObsiddyTimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, archivedAt])
  @@index([userId, visibility])
  @@index([userId, priorityScore(sort: Desc)])
  @@index([areaId])
  @@map("framework_obsiddy_project")
}

/// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
/// TWO Postgres objects on this model are raw SQL in the migration:
///
///   1. `GENERATED ALWAYS AS (to_tsvector('english', title || notes)) STORED`
///      on `searchVector` — Prisma cannot model GENERATED expressions.
///      Probe B4.
///   2. GIN index `idx_framework_obsiddy_task_search_vector` over it. Probe B5.
///
/// Tasks are deliberately NOT embedded (§1): titles are short, high-churn and
/// semantically thin, so a tsvector gives better recall for less money. That is
/// why this model has `searchVector` but no `indexedHash`.
model ObsiddyTask {
  id     String @id @default(cuid())
  userId String

  title String
  notes String? @db.Text

  /// SetNull, not Cascade: deleting a project must never destroy its tasks —
  /// they fall back to the inbox (§1).
  projectId String?

  /// todo | next | doing | waiting | done | dropped. These are also the default
  /// board columns (§12) — a card drag is a PATCH of this one field.
  status String @default("todo") @db.VarChar(16)

  dueAt DateTime?

  /// Doubles as the task snooze. `deferUntil > now` HARD-ZEROES urgency and
  /// short-circuits the score before any boost is applied (§10).
  deferUntil DateTime?

  estimateMinutes Int?

  /// low | medium | high — matched against the time-of-day energy profile.
  energy String? @db.VarChar(16)

  contextTag String? @db.VarChar(32)

  priorityScore Float @default(0)

  /// Records `base`, `manualBoost` and `boostActive` separately so the UI can
  /// say "ranked #1 — pinned by you, expires Friday" (§10).
  priorityFactors Json?

  /// Human veto over the machine's ranking, clamped to [-1, +1] and applied
  /// ADDITIVELY AFTER the weighted sum — that is what makes +1 provably
  /// outrank every unboosted task. NO AGENT MAY WRITE THIS (§10).
  manualBoost Float @default(0)

  /// An expired boost reads as 0 in the pure scorer — never lazily zeroed by a
  /// background job, so behaviour can't depend on whether the nightly run
  /// happened (§10).
  manualBoostExpiresAt DateTime?
  manualBoostReason    String?

  /// Repeated snoozing is a signal, not noise — five snoozes means "drop it",
  /// "it's blocked" or "it's too big". NEVER an input to score.ts (§10).
  snoozeCount   Int       @default(0)
  lastSnoozedAt DateTime?

  completedAt DateTime?

  /// GENERATED ALWAYS AS (...) STORED — managed by migration, populated by
  /// Postgres. See the drift warning above.
  searchVector Unsupported("tsvector")?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev Int @default(0)

  project    ObsiddyProject?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags       ObsiddyTaskTag[]
  checklist  ObsiddyChecklistItem[]
  boardCards ObsiddyBoardCard[]
  timeBlocks ObsiddyTimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, archivedAt])
  @@index([userId, visibility])
  @@index([userId, priorityScore(sort: Desc)])
  @@index([userId, dueAt])
  @@index([projectId])
  @@map("framework_obsiddy_task")
}

/// The capture inbox — the front door of the whole product.
model ObsiddyThought {
  id     String @id @default(cuid())
  userId String

  content String @db.Text

  /// web | pwa | voice | image | shortcut | email | chat | agent | api
  source String @default("web") @db.VarChar(16)

  /// Provider-side id (Postmark MessageID, Shortcut run id…) for replay dedupe.
  externalId String?

  /// inbox | promoted | dropped
  status String @default("inbox") @db.VarChar(16)

  /// Set when triage promotes this into a task/project/goal, so the thought
  /// keeps its provenance rather than being consumed.
  promotedToType String? @db.VarChar(16)
  promotedToId   String?

  snoozedUntil  DateTime?
  snoozeCount   Int       @default(0)
  lastSnoozedAt DateTime?

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, status, createdAt])
  @@index([userId, archivedAt])
  @@map("framework_obsiddy_thought")
}

/// The one polymorphic edge table (D2). No FKs to targets — orphans are swept
/// by `pruneObsiddyOrphans(userId)` and by the transactional delete services.
model ObsiddyLink {
  id     String @id @default(cuid())
  userId String

  sourceType String @db.VarChar(16)
  sourceId   String
  targetType String @db.VarChar(16)
  targetId   String

  /// relates_to | blocks | supports | mentions | duplicates
  kind String @default("relates_to") @db.VarChar(24)

  /// Cosine similarity for swept pairs; null for hand-made links.
  strength  Float?
  rationale String? @db.Text

  /// rule | agent | user | vault. 'vault' is dormant until Release 3 and ships
  /// now so the value never needs adding against live data (§15).
  origin String @default("rule") @db.VarChar(16)

  /// suggested | accepted | rejected | proposed.
  ///
  /// A 'rejected' row is a TOMBSTONE, not dead data: the sweep excludes any
  /// pair that already has a link row, so this is the only thing stopping the
  /// same suggestion returning every Sunday forever. Retention keeps rejected
  /// links FOREVER — pruning them silently reintroduces an infinite nag loop
  /// (§11). Someone will try to clean them up. Don't.
  status String @default("suggested") @db.VarChar(16)

  /// Hidden from the connections view; the sweep won't re-propose it (§10).
  snoozedUntil DateTime?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, targetType, targetId, kind])
  @@index([userId, status])
  @@index([userId, sourceType, sourceId])
  @@index([userId, targetType, targetId])
  @@map("framework_obsiddy_link")
}

/// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
/// THREE Postgres objects on this model are raw SQL in the migration:
///
///   1. `embedding vector(1536)` — the pgvector column type. Probe B2 asserts
///      the column exists.
///   2. HNSW index `idx_framework_obsiddy_embedding_hnsw`
///      (vector_cosine_ops, m=16, ef_construction=64). Probe B3. A drop here
///      is SILENT — search keeps working, just as a sequential scan.
///   3. `GENERATED ALWAYS AS (...) STORED` on `searchVector` + its GIN index
///      `idx_framework_obsiddy_embedding_search_vector`. Probe B6.
///
/// ONE vector table for all entity types (D2) — one column, one HNSW index,
/// one re-embed path, one search query. That cuts the pgvector drift surface
/// roughly five-fold versus a vector column per entity table.
///
/// Archiving DELETES the rows here rather than filtering them at query time:
/// HNSW is approximate, so a post-filter over a mostly-archived corpus returns
/// fewer rows than asked for, silently, degrading as history grows (§11).
model ObsiddyEmbedding {
  id     String @id @default(cuid())
  userId String

  /// thought | project | goal | area | entity | document. NOT task (§1).
  entityType String @db.VarChar(16)
  entityId   String
  chunkIndex Int    @default(0)

  content String @db.Text

  embedding    Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")?

  /// Hash of SEMANTIC CONTENT ONLY — never rendered markdown, or every
  /// frontmatter tick re-embeds the corpus (§17 risk 3).
  contentHash String

  /// When the connection sweep last examined this entity as a source.
  ///
  /// The sweep is capped per type per run, and this is what makes the cap rotate
  /// instead of re-examining the same head of the list for ever. Ordering by
  /// `embeddedAt desc` (the obvious choice) would leave everything past the cap
  /// permanently unreachable, because `embeddedAt` only moves on a re-embed.
  /// Null = never swept, which sorts first.
  sweptAt DateTime?

  embeddingModel     String?
  embeddingProvider  String?
  /// Probed by `assertActiveModelMatchesStoredVectors()` — without it a model
  /// swap becomes a cryptic SQL cast crash (§17 risk 5).
  embeddingDimension Int?
  embeddedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, entityType, entityId, chunkIndex])
  @@index([userId, entityType])
  @@index([userId, contentHash])
  @@map("framework_obsiddy_embedding")
}

/// A named, shareable kanban view. A board is a VIEW over tasks that already
/// exist, not a new subsystem (§12).
model ObsiddyBoard {
  id     String @id @default(cuid())
  userId String

  name        String
  slug        String
  description String? @db.Text

  /// Ordered list of { status, label, wipLimit? }.
  columns Json

  /// filter | explicit. A filter-backed board keeps sharing tasks you create
  /// later — intended, and the most likely way someone leaks something through
  /// this product (§17 risk 6b). The share dialog must disclose it in plain
  /// English and offer a snapshot instead.
  membership String @default("filter") @db.VarChar(16)

  filter Json?

  /// project | area | entity | none
  swimlaneBy String? @db.VarChar(16)

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  cards ObsiddyBoardCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, archivedAt])
  @@index([userId, visibility])
  @@map("framework_obsiddy_board")
}

/// Explicit board membership — only used when `membership: 'explicit'`.
model ObsiddyBoardCard {
  id     String @id @default(cuid())
  userId String

  boardId String
  taskId  String

  /// Sparse float ordering so a reorder writes one row, not the whole column.
  position Float

  board ObsiddyBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task  ObsiddyTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([boardId, taskId])
  @@index([userId])
  @@index([boardId, position])
  @@index([taskId])
  @@map("framework_obsiddy_board_card")
}

/// Trello-style coloured labels. A table rather than a `String[]` so a rename
/// is one write and export can carry colours (§12).
model ObsiddyTag {
  id     String @id @default(cuid())
  userId String

  name      String
  slug      String
  colour    String @default("slate") @db.VarChar(16)
  sortOrder Int    @default(0)

  tasks ObsiddyTaskTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, slug])
  @@map("framework_obsiddy_tag")
}

model ObsiddyTaskTag {
  id     String @id @default(cuid())
  userId String

  taskId String
  tagId  String

  task ObsiddyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  ObsiddyTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([userId])
  @@index([tagId])
  @@map("framework_obsiddy_task_tag")
}

/// Sub-steps within a card. Real FK with a real cascade — unlike the
/// polymorphic edge table, there is nothing to keep once the task is gone.
model ObsiddyChecklistItem {
  id     String @id @default(cuid())
  userId String

  taskId String
  text   String
  isDone Boolean @default(false)

  position    Float
  completedAt DateTime?

  task ObsiddyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([taskId, position])
  @@index([userId])
  @@map("framework_obsiddy_checklist_item")
}

/// People, companies and market segments — first-class nodes, NOT Areas.
///
/// An Area is a domain of your life with a weekly time target, and
/// `areaBalance` deliberately floats neglected ones upward. A client is not
/// that: balancing attention across customers the way you balance Health
/// against Career is wrong, and overloading Areas would corrupt the scorer.
/// Entities are therefore DELIBERATELY ABSENT from score.ts — a neglected
/// client surfaces through the stale digest, never by inflating task scores
/// (§1, §11).
model ObsiddyEntity {
  id     String @id @default(cuid())
  userId String

  name        String
  slug        String
  /// person | company | segment
  kind        String  @default("person") @db.VarChar(16)
  description String? @db.Text
  website     String?

  /// active | dormant | former
  status String @default("active") @db.VarChar(16)

  lastActivityAt DateTime?
  snoozedUntil   DateTime?

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, kind, status])
  @@index([userId, archivedAt])
  @@map("framework_obsiddy_entity")
}

/// Uploaded reference material. Parsed and chunked with the PLATFORM's parsers
/// (`lib/orchestration/knowledge/parsers/`), but stored in Obsiddy's own tables
/// so it stays inside the `WHERE userId = $1` invariant — the platform KB is a
/// global asset and per-user scoping there is a documented anti-pattern (§4).
model ObsiddyDocument {
  id     String @id @default(cuid())
  userId String

  title    String
  fileName String
  /// SHA-256 — a re-upload of the same bytes dedupes on this.
  fileHash String

  mimeType String
  /// Null when the original bytes were not retained — the default.
  ///
  /// Whether an upload's original file is kept is an **operator** decision
  /// (`ObsiddySettings.documentOriginals`), not a per-user one, because Sunrise's
  /// storage layer cannot hold private user files on every provider:
  /// `StorageProvider` has no read method at all, and `LocalProvider` ignores
  /// `public: false` and writes into `public/uploads/`, which Next serves
  /// statically at a guessable URL. So `discard` is the default and this column
  /// is empty on most rows — the extracted text and the embedding chunks are the
  /// product, the bytes are an optional convenience.
  storageKey String?
  byteSize   Int

  /// processing | ready | failed
  status     String @default("processing") @db.VarChar(16)
  chunkCount Int    @default(0)

  sourceUrl     String?
  errorMessage  String? @db.Text
  extractedText String? @db.Text

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  indexedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  /// Dedupe is enforced by the DATABASE, not just by the lookup that precedes it.
  ///
  /// `ingestDocument` checks `findDocumentByHash` first, but check-then-insert has
  /// a window: two simultaneous uploads of the same bytes both miss the check and
  /// both create a row, each paying to parse and embed the same file.
  /// `ObsiddyThought.externalId` got this treatment for exactly the same reason
  /// (a replayed webhook delivery); documents deserve it too. The unique index also
  /// serves the lookup, so it replaces the plain index rather than adding to it.
  @@unique([userId, fileHash])
  @@index([userId, archivedAt])
  @@map("framework_obsiddy_document")
}

/// Planned and actual time — feeds `effortFit` and the "organise my time"
/// requirement. Deliberately not vault-synced: calendar-shaped and high-churn.
model ObsiddyTimeBlock {
  id     String @id @default(cuid())
  userId String

  title String?

  taskId    String?
  projectId String?
  areaId    String?

  startAt DateTime
  endAt   DateTime

  /// plan | actual | calendar. Past unactioned 'plan' blocks prune at 90 days.
  source String @default("plan") @db.VarChar(16)

  notes String? @db.Text

  task    ObsiddyTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project ObsiddyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  area    ObsiddyArea?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([taskId])
  @@index([projectId])
  @@index([areaId])
  @@map("framework_obsiddy_time_block")
}

/// Generated artefacts — how background workflows persist output the UI can
/// render. Reviews sync one-way DB → vault: they are regenerated, and letting
/// vault edits flow back is a guaranteed data-loss complaint (§14).
model ObsiddyReview {
  id     String @id @default(cuid())
  userId String

  /// daily | weekly | month | quarter | briefing | connections
  horizon String @db.VarChar(16)

  title String
  body  String @db.Text

  /// Structured payload the UI renders as cards (selected task ids, counts,
  /// stale-item rows) alongside the prose.
  payload Json?

  generatedAt DateTime @default(now())

  /// Set when a workflow produced this, for provenance back to the run.
  workflowExecutionId String?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, horizon, generatedAt(sort: Desc)])
  @@index([userId, archivedAt])
  @@index([userId, visibility])
  @@map("framework_obsiddy_review")
}

/// Append-only activity log. The weekly review needs "what actually moved";
/// scanning `updatedAt` across five tables is the wrong answer (§1). This is
/// also what makes "what you achieved this week" possible at all (§6).
///
/// MUST NEVER CARRY AN EMAIL ADDRESS. Store `granteeUserId` or a hash — an
/// email in the owner's log survives the grantee's erasure (§1, §13).
model ObsiddyEvent {
  id     String @id @default(cuid())
  userId String

  /// captured | completed | promoted | archived | restored | snoozed |
  /// unsnoozed | linked | shared | revoked
  kind String @db.VarChar(24)

  entityType String @db.VarChar(16)
  entityId   String

  metadata Json?

  createdAt DateTime @default(now())

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/obsiddy-isolation.ts.
  space ObsiddySpace @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, entityType, entityId])
  @@map("framework_obsiddy_event")
}

/// Instance settings — the deliberate exception to rule 2 at the top of this file.
///
/// **This is the one Obsiddy table with no `userId`**, so it is also the one
/// table outside the D1 cascade. That is not an oversight: what it holds are
/// deployment facts, not user data. "Does this deployment's storage provider
/// hold private objects safely?" has one answer per install, and it belongs to
/// whoever operates the install — so it is an admin-area setting, and erasing a
/// user must not change it.
///
/// Singleton by `slug`, mirroring `AiOrchestrationSettings` — a `@unique`
/// defaulted column rather than a magic primary key, so the upsert has a natural
/// target and a second row is a constraint violation rather than a silent
/// second source of truth.
model ObsiddySettings {
  id   String @id @default(cuid())
  slug String @unique @default("global")

  /// discard | retain — what happens to an uploaded document's original bytes.
  ///
  /// `discard` (default) parses the file, keeps `extractedText` and the embedding
  /// chunks, and drops the buffer: no blob, no download surface, nothing to leak.
  /// `retain` uploads under `framework-obsiddy/<userId>/<fileHash>` with
  /// `public: false` and serves downloads through a short-lived signed URL, which
  /// only works on a provider that implements `getSignedUrl` and stores objects
  /// privately. The admin page names the resolved provider and says so, because
  /// choosing `retain` on the local provider means writing user documents into a
  /// statically-served directory.
  documentOriginals String @default("discard") @db.VarChar(16)

  /// Upload ceiling in bytes. Null falls back to the code default.
  ///
  /// A setting rather than a constant because Sunrise ships two contradictory
  /// caps — 5 MB global (`lib/validations/storage.ts`) and 50 MB local to the
  /// bulk knowledge route — and Obsiddy has to pick one without pretending the
  /// other doesn't exist (Sunrise ask #9).
  maxDocumentBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("framework_obsiddy_settings")
}
