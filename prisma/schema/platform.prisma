// Contact Form Submissions (Phase 3.5)
// Stores contact form submissions from the public website
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@index([read, createdAt])
  @@map("contact_submission")
}

// Feature Flags (Phase 4.4)
// Runtime feature toggle system for admin-controlled features
model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "ENABLE_BETA_FEATURES"
  enabled     Boolean  @default(false)
  description String?  @db.Text
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@index([name])
  @@map("feature_flag")
}

// Auth bootstrap marker (issue #278)
// Singleton row recording that the one-time first-user-is-admin bootstrap has
// completed. `userCreateBeforeHook` promotes the first human signup on a fresh
// database to ADMIN; this row makes that promotion fire at most once over the
// instance's lifetime. Once present, the bootstrap never fires again — even if
// every human account is later deleted and the live user count returns to zero
// — closing a re-bootstrap privilege-escalation window. Keyed by a fixed id
// (AUTH_BOOTSTRAP_ID = "singleton") so at most one row can exist.
model AuthBootstrap {
  id          String   @id // always AUTH_BOOTSTRAP_ID ("singleton")
  completedAt DateTime @default(now())

  @@map("auth_bootstrap")
}

/// Tracks which seed units have been applied, keyed by unit name.
///
/// Each entry in `prisma/seeds/` is hashed by source content; the runner
/// skips units whose hash matches the stored `contentHash`, and re-runs
/// units whose file has changed. This lets teammates pull new/edited
/// seeds and apply them incrementally without manual coordination.
model SeedHistory {
  id          String   @id @default(cuid())
  name        String   @unique
  contentHash String
  appliedAt   DateTime @default(now())
  durationMs  Int

  @@map("seed_history")
}

/// Append-only receipt of a completed right-to-erasure (account deletion).
///
/// Written inside the same transaction as `prisma.user.delete` by
/// `lib/privacy/erase-user.ts`, so a receipt exists iff the user was erased.
/// Demonstrates GDPR Art. 5(2) accountability without re-introducing the
/// subject's PII: the user id is opaque (the row is gone) and the email is
/// stored only as a SHA-256 hash for correlating a later "did you erase me?"
/// request. No foreign keys — the receipt must outlive every referenced row,
/// including the actor if they are later erased too.
model DataErasureReceipt {
  id               String   @id @default(cuid())
  subjectUserId    String // id of the erased user (no FK — the user row is gone)
  subjectEmailHash String? // sha256(lowercased email); for correlation, not reversible
  actorUserId      String? // who initiated the erasure (self or an admin)
  reason           String // "self_service" | "admin_action"
  erasedAt         DateTime @default(now())
  metadata         Json? // optional summary (e.g. counts)

  @@index([subjectUserId])
  @@index([erasedAt])
  @@map("data_erasure_receipt")
}

/// One asked-for account transfer, run away from the request that asked for it.
///
/// Everything `lib/portability/**` does synchronously has a ceiling set by how
/// long somebody will hold a request open, not by anything about the data: an
/// export builds the whole archive in memory before the first byte is sent, and
/// an import runs in one transaction. Both are correct and both mean a large
/// account cannot move at all. This row is the handle on doing the same work
/// with nobody waiting.
///
/// The archive lives in blob storage, never in this row. An export bundle is a
/// copy of somebody's entire account, so it is written privately, fetched
/// through a short-lived signed URL, and deleted at `expiresAt` — a job table is
/// no place to accumulate them, and neither is a bucket.
///
/// Claimed with the lease/orphan pattern the evaluation-run worker established
/// (`lockedBy` + `lockedAt`), so two instances of the maintenance tick cannot
/// run one person's import twice.
///
/// @see lib/portability/jobs/worker.ts
/// @see .context/framework/resparkable/transfer.md
model TransferJob {
  id     String @id @default(cuid())
  userId String
  /// Personal data: this describes one person's own account moving. Erased with
  /// them — and `eraseUser()` drops the stored archive before the row goes, or
  /// the bucket would keep a full copy of an account that was just erased.
  user   User   @relation("TransferJobUser", fields: [userId], references: [id], onDelete: Cascade)

  /// "export" | "import"
  kind   String
  /// "queued" | "running" | "completed" | "failed" | "expired"
  status String @default("queued")

  // ── what was asked for ──
  /// Export only. Null on an import, which reads whatever the bundle holds.
  format           String?
  /// Sections. Empty means every one the format covers.
  groups           String[]
  includeOriginals Boolean  @default(false)
  /// Import only. "skip" | "overwrite".
  conflictMode     String?
  /// Import only. False plans and writes nothing, as the synchronous route does.
  apply            Boolean  @default(false)

  // ── the archive, in blob storage ──
  /// Uploaded bundle on an import, produced bundle on an export. Null until built.
  storageKey String?
  fileName   String?
  bytes      Int?

  // ── what came of it ──
  /// The plan, or the outcome, as the synchronous routes return it.
  result      Json?
  /// Shown to the user verbatim — these errors are written to be readable.
  error       String? @db.Text
  /// The machine-readable half, matching the synchronous routes' `reason`.
  errorReason String?

  // ── the lease ──
  lockedBy String?
  lockedAt DateTime?
  attempts Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  /// When the stored archive is deleted. Set once there is one to delete.
  expiresAt  DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("transfer_job")
}
