# Non-secret local development settings for THIS app.
#
# Unlike .env.local (ignored, holds secrets), this file is committed: it is how
# an app pins the port it binds so every clone agrees and `npm run dev` needs no
# arguments. Read by scripts/dev-server.mjs — see
# .context/environment/services-env.md#port
#
# Secrets belong in .env.local. Never add one here.

# Resparkable. Allocated in the shared HCE dev-proxy registry, which maps
# https://resparkable.test -> 127.0.0.1:3016:
#   https://github.com/human-centric-engineering/dev-proxy  (apps.json)
#
# Change it there, not here, then re-run ./apply.sh — the two have to agree or
# the proxy points at nothing. 3010 is Resparkable's own port and inheriting it
# would collide the moment both run side by side, which is the whole reason the
# registry exists.
PORT=3016
